<div class="layout layout--col layout--stretch-x ld">
  {%- if hero -%}
  <div class="ld-main ld-main--hh grid grid--cols-12 gap--medium h--full">
    <div class="ld-frame ld-frame--row col--span-7 portrait:col--span-12">
      <img class="image image-dither image--cover h--full no-shrink ld-art ld-art--side" src="{{ hero.tall | default: hero.wide }}" alt="">
      {{ hero_body }}
    </div>
    <div class="ld-frame col--span-5 portrait:col--span-12">
      <div class="flex flex--row flex--between bg--black text--white px--2 py--1 lg:px--3"><span class="label lg:label--large ld-sm no-shrink">Inventory</span><span class="label lg:label--large ld-sm no-shrink">{{ loot.count | minus: 1 }} more</span></div>
      <div class="ld-list grow flex flex--col flex--stretch-x gap--none">
        {%- for it in loot.live offset: 1 limit: 6 -%}
        {% if forloop.index > 4 %}<div class="ld-li lg:portrait:hidden">{% else %}<div class="ld-li">{% endif %}<div class="ld-line flex flex--row flex--left flex--center-y gap--small px--1 py--1 lg:px--2"><span class="label lg:label--large ld-tag no-shrink">{{ it.store }}</span><span class="label lg:label--large ld-sm ld-clip grow">{{ it.title }}</span><span class="label lg:label--large ld-sm no-shrink">{% assign tl = t_left[forloop.index] %}{% if tl == "NO TIMER" %}--{% else %}{{ tl | split: " " | first }}{% endif %}</span></div></div>
        {%- endfor -%}
      </div>
    </div>
  </div>
    {%- else -%}
  {{ empty_screen }}
  {%- endif -%}
</div>
