{%- comment -%} The little adventurer under the inventory: cheers for new loot, waits, or sleeps when nothing is free. {%- endcomment -%}
{%- capture scene -%}
<div class="ld-scene flex flex--row flex--left flex--bottom gap--xsmall px--2 pt--1 lg:px--3 lg:pt--2">
  {%- if loot.count == 0 -%}{{ sp_hero_sleep }}{{ sp_chest_shut }}
  {%- elsif loot.fresh > 0 -%}{{ sp_hero_yay }}{{ sp_chest_open }}
  {%- else -%}{{ sp_hero_wait }}{{ sp_chest_shut }}{%- endif -%}
  <div class="ld-bubble flex flex--col flex--stretch-x gap--xsmall self--center">
    {%- if loot.count == 0 -%}<span class="label lg:label--large ld-sm no-shrink">Zzz... no loot</span>
    {%- elsif loot.fresh > 0 -%}<span class="label lg:label--large ld-sm no-shrink">New loot!</span><span class="label lg:label--large ld-sm no-shrink">{{ loot.fresh }} dropped today</span>
    {%- else -%}<span class="label lg:label--large ld-sm no-shrink">Waiting for loot...</span>{%- endif -%}
    {%- if nx and loot.fresh == 0 -%}{%- assign nin = nx.starts | minus: loot.now -%}{%- assign nd = nin | divided_by: 86400 | floor -%}{%- assign nh = nin | modulo: 86400 | divided_by: 3600 | floor -%}<span class="label lg:label--large ld-sm no-shrink">Next drop in {% if nd > 0 %}{{ nd }}D {% endif %}{{ nh }}H</span>{%- endif -%}
  </div>
</div>
{%- endcapture -%}

{%- comment -%} When there is nothing to show: the stores did not answer, or nothing is free right now. {%- endcomment -%}
{%- capture empty_screen -%}
<div class="ld-empty flex flex--row flex--center gap--large p--2 lg:p--3 grow">
  <div class="flex flex--row flex--bottom gap">{%- if loot.status == "offline" -%}{{ sp_hero_sleep }}{{ sp_chest_shut }}{%- else -%}{{ sp_hero_wait }}{{ sp_chest_shut }}{%- endif -%}</div>
  <div class="ld-bubble flex flex--col flex--stretch-x gap--xsmall self--center">
    {%- if loot.status == "offline" -%}
      <span class="value value--small lg:value--base ld-px">Connection lost</span>
      <span class="label lg:label--large ld-sm no-shrink">The loot servers did not answer. Retrying on the next refresh.</span>
    {%- else -%}
      <span class="value value--small lg:value--base ld-px">No free loot</span>
      <span class="label lg:label--large ld-sm no-shrink">{% if nx %}{%- assign nin = nx.starts | minus: loot.now -%}{%- assign nd = nin | divided_by: 86400 | floor -%}{%- assign nh = nin | modulo: 86400 | divided_by: 3600 | floor -%}Next drop in {% if nd > 0 %}{{ nd }}D {% endif %}{{ nh }}H{% else %}Nothing is free in these stores right now. Check back later.{% endif %}</span>
    {%- endif -%}
  </div>
</div>
{%- endcapture -%}

{%- comment -%} The featured drop as one card, reused by the smaller sizes. {%- endcomment -%}
{%- capture hero_body -%}
<div class="flex flex--row flex--center-y gap--none"><div class="ld-body grow flex flex--col flex--stretch-x gap--xsmall p--2 lg:gap--small lg:p--3">
  <div class="flex flex--row flex--left flex--center-y gap--small"><span class="label lg:label--large ld-tag bg--black no-shrink">{{ hero.store_name }}</span></div>
  <span class="value value--small lg:value--base ld-px ld-clip">{{ hero.title }}</span>
  <span class="label lg:label--large ld-sm ld-clip"><span class="ld-strike">{{ hero.worth_txt }}</span> &gt;&gt; FREE</span>
  {%- if hero.hp -%}{%- assign on = hero.hp | divided_by: 10 | round -%}
  <div class="flex flex--row flex--between flex--center-y gap--small"><div class="ld-hp grow">{%- for i in (1..10) -%}<i{% if i <= on %} class="on"{% endif %}></i>{%- endfor -%}</div><span class="label lg:label--large ld-sm no-shrink">{{ t_left[0] }}</span></div>
  {%- endif -%}
</div><div class="no-shrink pr--1 lg:pr--2"><div class="ld-qrwrap ld-qrwrap--md">{{ hero.url | qr_code: 2, "l", fixed }}</div></div></div>
{%- endcapture -%}
