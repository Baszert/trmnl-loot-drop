{%- comment -%} The little adventurer under the inventory: cheers for new loot, waits, or sleeps when nothing is free. {%- endcomment -%}
{%- capture scene -%}
<div class="ld-scene">
  {%- if loot.count == 0 -%}{{ sp_hero_sleep }}{{ sp_chest_shut }}
  {%- elsif loot.fresh > 0 -%}{{ sp_hero_yay }}{{ sp_chest_open }}
  {%- else -%}{{ sp_hero_wait }}{{ sp_chest_shut }}{%- endif -%}
  <div class="ld-bubble">
    {%- if loot.count == 0 -%}<span class="ld-sm">Zzz... no loot</span>
    {%- elsif loot.fresh > 0 -%}<span class="ld-sm">New loot!</span><span class="ld-sm">{{ loot.fresh }} dropped today</span>
    {%- else -%}<span class="ld-sm">Waiting for loot...</span>{%- endif -%}
    {%- if nx and loot.fresh == 0 -%}{%- assign nin = nx.starts | minus: loot.now -%}{%- assign nd = nin | divided_by: 86400 | floor -%}{%- assign nh = nin | modulo: 86400 | divided_by: 3600 | floor -%}<span class="ld-sm">Next drop in {% if nd > 0 %}{{ nd }}D {% endif %}{{ nh }}H</span>{%- endif -%}
  </div>
</div>
{%- endcapture -%}

{%- comment -%} When there is nothing to show: the stores did not answer, or nothing is free right now. {%- endcomment -%}
{%- capture empty_screen -%}
<div class="ld-empty">
  <div class="ld-empty-art">{%- if loot.status == "offline" -%}{{ sp_hero_sleep }}{{ sp_chest_shut }}{%- else -%}{{ sp_hero_wait }}{{ sp_chest_shut }}{%- endif -%}</div>
  <div class="ld-bubble">
    {%- if loot.status == "offline" -%}
      <span class="ld-px">Connection lost</span>
      <span class="ld-sm">The loot servers did not answer. Retrying on the next refresh.</span>
    {%- else -%}
      <span class="ld-px">No free loot</span>
      <span class="ld-sm">{% if nx %}{%- assign nin = nx.starts | minus: loot.now -%}{%- assign nd = nin | divided_by: 86400 | floor -%}{%- assign nh = nin | modulo: 86400 | divided_by: 3600 | floor -%}Next drop in {% if nd > 0 %}{{ nd }}D {% endif %}{{ nh }}H{% else %}Nothing is free in these stores right now. Check back later.{% endif %}</span>
    {%- endif -%}
  </div>
</div>
{%- endcapture -%}

{%- comment -%} The featured drop as one card, reused by the smaller sizes. {%- endcomment -%}
{%- capture hero_body -%}
<div class="ld-foot"><div class="ld-body ld-grow">
  <div class="ld-row ld-row--left"><span class="ld-tag ld-tag--on">{{ hero.store_name }}</span></div>
  <span class="ld-px ld-clip">{{ hero.title }}</span>
  <span class="ld-sm ld-clip"><span class="ld-strike">{{ hero.worth_txt }}</span> &gt;&gt; FREE</span>
  {%- if hero.hp -%}{%- assign on = hero.hp | divided_by: 10 | round -%}
  <div class="ld-row"><div class="ld-hp ld-grow">{%- for i in (1..10) -%}<i{% if i <= on %} class="on"{% endif %}></i>{%- endfor -%}</div><span class="ld-sm">{{ t_left[0] }}</span></div>
  {%- endif -%}
</div><div class="ld-qrbox"><div class="ld-qrwrap ld-qrwrap--md">{{ hero.url | qr_code: 2, "l", fixed }}</div></div></div>
{%- endcapture -%}
